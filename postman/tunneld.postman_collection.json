        {
          "name": "Enable hostname tunnel",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('same stable URL again', () => {",
                  "  pm.response.to.have.status(200);",
