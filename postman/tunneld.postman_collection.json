            "url": {
              "raw": "{{base_url}}/api/tunnels/{{host_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "tunnels",
                "{{host_id}}"
              ]
            }
          },
          "response": []
